.gradle/
.kotlin/
build/
app/.cxx/
local.properties
*.iml
.idea/
captures/
# Local test media and results stay on this PC (copyrighted film, generated subtitles).
test-media/
test-results/private/
# Copied from the root THIRD_PARTY_NOTICES.md at build time.
app/src/main/assets/licenses/THIRD_PARTY_NOTICES.md
# Built APKs (the deliverable copy in the folder root is not versioned).
/*.apk
/*.aab
# Optional FFmpeg build output (scripts/build_ffmpeg.sh); configuration-*.txt is versioned.
app/src/main/ffmpeg/jniLibs/
app/src/main/ffmpeg/include/
# FFmpeg source tarball shared alongside the APK (LGPL); downloaded by scripts/build_ffmpeg.sh.
/ffmpeg-*.tar.xz
# device benchmark output (scripts/device_bench.sh)
/bench/
# Models bundled into the APK (fetched by the fetchModels Gradle task, about 780 MB).
/bundled-models/
# Release signing key and its passwords: never committed, back them up yourself.
/keystore.properties
/signing/
