<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The built-in browser loads the websites the user opens. Nothing else uses the network:
         every model is bundled, and movies, audio and subtitles never leave the device.
         Media3 declares these two for streaming and wake locks, which the app does not use. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- usesCleartextTraffic below: like any browser it opens http:// sites the user types or
         follows; the browser is the only part of the app that uses the network. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />
    <uses-permission android:name="android.permission.WAKE_LOCK" tools:node="remove" />

    <!-- Live Floating Subtitles only, each asked for when the user starts a session:
         subtitles over other apps, the sound to recognise (Android requires RECORD_AUDIO for
         playback capture too) and the foreground service with its ongoing notification.
         The audio never leaves the phone. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <application
        android:name=".App"
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:extractNativeLibs="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.PlayerActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="true"
            android:theme="@style/AppTheme.Player">
            <!-- "Open with" from file managers and galleries. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="video/*" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.ModelsActivity"
            android:exported="false"
            android:label="@string/models_title" />

        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title" />

        <activity
            android:name=".ui.AboutActivity"
            android:exported="false"
            android:label="@string/about_title" />

        <!-- Exported without an intent filter for the emulator test hook (test_audio extra:
             a file the app itself holds); started otherwise it only shows the dashboard. -->
        <activity
            android:name=".ui.LiveActivity"
            android:exported="true"
            android:label="@string/live_title"
            android:launchMode="singleTop" />

        <activity
            android:name=".ui.LiveSettingsActivity"
            android:exported="false"
            android:label="@string/live_settings_title" />

        <activity
            android:name=".ui.SecondDeviceActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="false"
            android:label="@string/live_title"
            android:theme="@style/AppTheme.Player" />

        <activity
            android:name=".ui.BrowserActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="false"
            android:launchMode="singleTask" />

        <!-- No usage metrics from the browser's WebView to Google. -->
        <meta-data
            android:name="android.webkit.WebView.MetricsOptOut"
            android:value="true" />

        <service
            android:name=".live.LiveSubtitleService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection|microphone" />
    </application>
</manifest>
